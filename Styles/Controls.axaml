<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia">
    <!-- Shared typography, spacing, and surface resources. -->
    <Styles.Resources>
        <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <x:Double x:Key="BodyFontSize">10</x:Double>
        <x:Double x:Key="HeadingFontSize">15</x:Double>
        <x:Double x:Key="LabelFontSize">12</x:Double>
        <x:Double x:Key="InputFontSize">12</x:Double>
        <x:Double x:Key="ControlHeight">32</x:Double>
        <x:Double x:Key="DisabledControlOpacity">0.45</x:Double>
        <x:Double x:Key="PageSpacing">10</x:Double>
        <Thickness x:Key="PageMargin">13</Thickness>
        <CornerRadius x:Key="ControlRadius">8</CornerRadius>
        <CornerRadius x:Key="CardRadius">8</CornerRadius>
    </Styles.Resources>

    <Style Selector="Button, RepeatButton, ToggleButton, RadioButton, CheckBox, TabItem">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.description">
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.unit">
        <Setter Property="FontSize" Value="9.75" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="5,0,6,0" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SectionGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style Selector="Border.segments">
        <Setter Property="Background" Value="{DynamicResource ButtonOffBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>

    <Style Selector="svg|Svg.action-icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</Styles>
