<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AutoClicker.ViewModels" x:DataType="vm:MainViewModel" x:CompileBindings="True" xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia" x:Class="AutoClicker.Views.MacrosView">

    <UserControl.Styles>
        <Style Selector="Border.macro-panel">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Grid.macro-columns">
            <Setter Property="ColumnSpacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.table-heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,*" RowSpacing="{StaticResource PageSpacing}">
            <Border Classes="card">
                <Grid ColumnDefinitions="*,230" ColumnSpacing="14">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="section-title" Text="Macro Recorder" />
                            <TextBlock Classes="description" Text="Record mouse clicks and keyboard input." />
                        </StackPanel>
                        <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="10" Height="90">
                            <Button Name="RecordButton" Command="{Binding RecordCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding RecordLabel}">
                                <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                    <svg:Svg Classes="action-icon" Path="/Assets/Icons/record.svg" Width="52" Height="52" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Classes="section-title" Text="{Binding RecordLabel}" TextWrapping="Wrap" />
                                        <TextBlock Classes="description" Text="{Binding RecordDescription}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Grid.Column="1" Classes="macro-panel">
                                <StackPanel Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Classes="description" Text="Start Recording Hotkey" />
                                    <Button Content="{Binding RecordStartHotkey}" Command="{Binding ConfigureCommand}" AutomationProperties.Name="Start recording hotkey" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="macro-panel">
                                <StackPanel Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Classes="description" Text="Stop Recording Hotkey" />
                                    <Button Content="{Binding RecordStopHotkey}" Command="{Binding ConfigureCommand}" AutomationProperties.Name="Stop recording hotkey" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="macro-panel">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="Recording Options" Margin="0,0,0,4" />
                            <CheckBox Content="Record mouse clicks" IsChecked="{Binding RecordClicks, Mode=TwoWay}" IsEnabled="{Binding SettingsEditable}" />
                            <CheckBox Content="Record keyboard input" IsChecked="{Binding RecordKeyboard, Mode=TwoWay}" IsEnabled="{Binding SettingsEditable}" />
                            <TextBlock Classes="description" Text="Clicks save their cursor position." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="1" Classes="card" MinHeight="378">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,200" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="section-title" Text="Recorded Macros" />
                            <TextBlock Classes="description" Text="Manage your recorded macros." />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search..." VerticalAlignment="Center" AutomationProperties.Name="Search macros" />
                    </Grid>
                    <StackPanel Spacing="5">
                        <Border Classes="macro-panel" Padding="9,9" Background="{DynamicResource ButtonOffBrush}">
                            <!-- Keep these column widths aligned with the item template below. -->
                            <Grid Classes="macro-columns" ColumnDefinitions="20,*,120,164,65,126,114">
                                <Button Grid.Column="1" Classes="compact" Content="Name  ↕" Command="{Binding SortCommand}" CommandParameter="Name" />
                                <Button Grid.Column="2" Classes="compact" Content="Hotkey (Play)  ↕" Command="{Binding SortCommand}" CommandParameter="Hotkey" />
                                <Button Grid.Column="3" Classes="compact" Content="Repeat  ↕" Command="{Binding SortCommand}" CommandParameter="Repeat" />
                                <Button Grid.Column="4" Classes="compact" Content="Length  ↕" Command="{Binding SortCommand}" CommandParameter="Length" />
                                <Button Grid.Column="5" Classes="compact" Content="Created  ↕" Command="{Binding SortCommand}" CommandParameter="Created" />
                                <TextBlock Grid.Column="6" Classes="table-heading" Text="Actions" />
                            </Grid>
                        </Border>
                        <ItemsControl Name="MacroItems" ItemsSource="{Binding VisibleMacros}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MacroViewModel" x:CompileBindings="True">
                                    <Border Classes="macro-panel" Padding="9,8" Background="{DynamicResource BackgroundBrush}" DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
                                        <Grid Classes="macro-columns" ColumnDefinitions="20,*,120,164,65,126,114">
                                            <TextBlock Text="⠿" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="16" PointerPressed="OnDragHandlePressed" Cursor="SizeAll" IsEnabled="{Binding Owner.CanReorder}" ToolTip.Tip="Drag to reorder; clear search and sorting first" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="{Binding Hotkey}" Command="{Binding Owner.ConfigureCommand}" AutomationProperties.Name="Macro play hotkey" />
                                            <Grid Grid.Column="3" ColumnDefinitions="72,*" ColumnSpacing="8">
                                                <NumericUpDown Value="{Binding Repeat, Mode=TwoWay}" Minimum="1" Maximum="1000000" IsEnabled="{Binding RepeatEditable}" AutomationProperties.Name="Repeat count" />
                                                <CheckBox Grid.Column="1" Content="Infinite" IsChecked="{Binding Infinite, Mode=TwoWay}" IsEnabled="{Binding Owner.SettingsEditable}" />
                                            </Grid>
                                            <TextBlock Grid.Column="4" Text="{Binding Length}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Created}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="icon-button" ToolTip.Tip="{Binding PlayTip}" AutomationProperties.Name="Play macro" Command="{Binding Owner.PlayMacroCommand}" CommandParameter="{Binding}">
                                                    <svg:Svg Classes="action-icon" Path="/Assets/Icons/play.svg" />
                                                </Button>
                                                <Button Classes="icon-button" ToolTip.Tip="Edit macro" AutomationProperties.Name="Edit macro" Command="{Binding Owner.EditMacroCommand}" CommandParameter="{Binding}">
                                                    <svg:Svg Classes="action-icon" Path="/Assets/Icons/edit.svg" />
                                                </Button>
                                                <Button Classes="icon-button danger" ToolTip.Tip="Delete macro" AutomationProperties.Name="Delete macro" Command="{Binding Owner.DeleteMacroCommand}" CommandParameter="{Binding}">
                                                    <svg:Svg Classes="action-icon" Path="/Assets/Icons/delete.svg" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding EmptyMacroText}" IsVisible="{Binding NoVisibleMacros}" Classes="description" Margin="8,12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
