<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AutoClicker.ViewModels" x:DataType="vm:MainViewModel" x:CompileBindings="True" x:Class="AutoClicker.Views.AboutView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22" Width="520" HorizontalAlignment="Left">

            <Grid ColumnDefinitions="*,Auto" Margin="0,18">
                <TextBlock Classes="section-title" Text="Version" />
                <TextBlock Grid.Column="1" Classes="label muted" Text="{Binding Version}" />
            </Grid>

            <Border Classes="divider" />

            <Grid ColumnDefinitions="*,86" ColumnSpacing="19" Margin="0,18">
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-title" Text="Reset All Settings" />
                    <TextBlock Classes="description" Text="Restores clicker, recording options, and control hotkeys. Keeps saved macros and statistics." />
                </StackPanel>
                <Button Grid.Column="1" Classes="danger" Content="Reset" Command="{Binding ResetCommand}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Grid>

            <Border Classes="divider" />

            <StackPanel Spacing="22" Margin="0,18,0,24">
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-title" Text="Total Clicks" />
                    <TextBlock Classes="description" Text="{Binding TotalClicks}" />
                </StackPanel>
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-title" Text="Time Spent Clicking" />
                    <TextBlock Classes="description" Text="{Binding TotalTime}" />
                </StackPanel>
                <StackPanel Spacing="5">
                    <TextBlock Classes="section-title" Text="Sessions" />
                    <TextBlock Classes="description" Text="{Binding Sessions}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
